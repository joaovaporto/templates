# Copy to .env and adjust. All variables use the APP_ prefix (see presentation/settings.py).

# Which repository adapter the composition root builds. One of: memory, jsonfile.
# 'jsonfile' requires the extra:  uv sync --extra jsonfile
APP_REPOSITORY_BACKEND=memory

# Path used only by the jsonfile backend.
APP_JSONFILE_PATH=notes.json

# Verbose logging.
APP_DEBUG=false
