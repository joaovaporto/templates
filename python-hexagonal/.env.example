# Copy to .env and adjust. All variables use the APP_ prefix (see presentation/settings.py).

# Which backend implements NoteRepositoryPort. The value is a directory name under
# src/app/infrastructure/ — an unknown one fails at startup listing the real ones.
# 'jsonfile' requires the extra:  uv sync --extra jsonfile
APP_NOTE_REPOSITORY_BACKEND=memory

# Adapter constructor arguments follow <backend>_<argument>. This one supplies
# OrjsonNoteRepositoryAdapter(path=...) and is read only when that backend is selected.
APP_JSONFILE_PATH=notes.json

# ClockPort has a single implementation, so no setting names it.

# Verbose logging.
APP_DEBUG=false
